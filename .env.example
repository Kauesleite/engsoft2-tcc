# Postgres (Neon). Sem DATABASE_URL o app usa um Postgres embutido (PGlite) só para desenvolvimento.
DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require
# Segredo para assinar o cookie de sessão (qualquer string longa e aleatória)
SESSION_SECRET=troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais
# Se "true": cria as tabelas e carrega dados de demonstração automaticamente no primeiro acesso
DEMO_SEED=true
